# Everything here is optional. Copy to .env and uncomment what you need.

# Host user that owns ./data (files created from the web keep this owner). install.sh fills these in.
# PUID=1000
# PGID=1000

# Port and bind address on the host. Keep 127.0.0.1 unless the hub sits behind a firewall/VPN:
# the dashboard gives full shell access.
# HERMITHUB_PORT=8787
# HERMITHUB_BIND=127.0.0.1

# Built-in HTTPS via Caddy + Let's Encrypt (ports 80/443 must be reachable, DNS pointing here).
# COMPOSE_PROFILES=https
# HERMITHUB_DOMAIN=hub.example.com
# PUBLIC_ORIGIN=https://hub.example.com
# TRUST_PROXY=1

# Public origin(s) of the site, comma separated, when served through your own reverse proxy.
# Used for the cross-site request check and to mark the session cookie Secure.
# PUBLIC_ORIGIN=https://hub.example.com

# Where data lives on the host (default: ./data next to docker-compose.yml). It becomes the home folder
# of the container user. Projects default to its projects/ folder; set HERMITHUB_PROJECTS to keep them
# elsewhere on the host.
# HERMITHUB_DATA=./data
# HERMITHUB_PROJECTS=/srv/code
# HERMITHUB_CADDY=./caddy

# Image tag to run (default: latest).
# HERMITHUB_VERSION=latest

# Headless installs only: seed the login password instead of using the setup page.
# HERMITHUB_PASSWORD=

# Which header carries the client IP, for the failed-login lockout. Leave empty when nothing sits in front
# (forwarded headers are then ignored, since anyone can send them). 1 = last X-Forwarded-For entry
# (Caddy, nginx, Traefik), cloudflare = CF-Connecting-IP (Cloudflare Tunnel).
# TRUST_PROXY=
